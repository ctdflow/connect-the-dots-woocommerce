{
    "name": "ctdflow/connect-the-dots-woocommerce",
    "description": "Plan the delivery routes of your WooCommerce orders with Connect the Dots.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "woocommerce",
        "wordpress",
        "route planner",
        "route optimization",
        "delivery routes"
    ],
    "homepage": "https://ctdflow.com/woocommerce",
    "support": {
        "issues": "https://github.com/ctdflow/connect-the-dots-woocommerce/issues",
        "source": "https://github.com/ctdflow/connect-the-dots-woocommerce"
    },
    "require": {
        "php": ">=8.1",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "ConnectTheDots\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
