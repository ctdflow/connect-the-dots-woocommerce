#. Plugin Name of the plugin
#: connect-the-dots.php
msgid "Connect the Dots: Delivery Route Planner for WooCommerce"
msgstr "Connect the Dots: Delivery Route Planner for WooCommerce"

#. Description of the plugin
#: connect-the-dots.php
msgid "Plans delivery routes for your WooCommerce orders with Connect the Dots."
msgstr "Plant bezorgritten voor je WooCommerce bestellingen met Connect the Dots."

#. Author of the plugin
#: connect-the-dots.php
msgid "Connect the Dots"
msgstr "Connect the Dots"

#. Author URI of the plugin
#: connect-the-dots.php
msgid "https://ctdflow.com"
msgstr "https://ctdflow.com/nl"

