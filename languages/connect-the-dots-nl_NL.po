#. translators: 1: date and time, 2: delivery date.
#: src/Admin/SettingsPage.php:393
#, php-format
msgid "%1$s: not planned, because %2$s already has routes. New orders came in since and are not on them. Plan that day again on the Routes tab to add them."
msgstr "%1$s: niet gepland, omdat %2$s al ritten heeft. Daarna zijn er nieuwe bestellingen binnengekomen die niet op de ritten staan. Plan die dag opnieuw op het tabblad Ritten om ze toe te voegen."

#: src/Admin/SettingsPage.php:268
msgid "Plan orders with shipping method"
msgstr "Plan bestellingen met verzendmethode"

#: src/Admin/SettingsPage.php:281
msgid "Choose none to plan orders with any shipping method. Orders that are picked up, and orders with only virtual products, are always left out."
msgstr "Kies er geen om bestellingen met elke verzendmethode te plannen. Bestellingen die worden afgehaald en bestellingen met alleen virtuele producten blijven altijd buiten de planning."

#: src/ApiError.php:116
msgid "The working hours of every van are over for today. Plan another day or set later hours for a van."
msgstr "De werktijden van alle bussen zijn voorbij voor vandaag. Plan een andere dag of geef een bus latere tijden."

#: src/DeliverySync.php:203
msgid "The driver undid the delivery"
msgstr "De chauffeur heeft de levering ongedaan gemaakt"

#: src/Admin/RoutesPage.php:802
msgid "No van has what this stop needs"
msgstr "Geen bus heeft wat deze stop nodig heeft"

#: src/Admin/RoutesPage.php:804
msgid "Larger than what any van can carry"
msgstr "Groter dan wat een bus kan meenemen"

#: src/Admin/RoutesPage.php:806
msgid "No van can reach the time window within its working hours"
msgstr "Geen bus haalt het tijdvak binnen zijn werktijden"

